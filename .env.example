# ==============================================================================
# FrenchBell Cafe — Environment Configuration Example
# Copy this file to '.env' and fill in REAL values for your deployment.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# SERVER & APPLICATION
# ──────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5173

# JWT secret — must be at least 32 random characters, keep secret
JWT_SECRET=replace_with_a_long_random_cryptographic_secret_key_minimum_32_chars

# ──────────────────────────────────────────────────────────────────────────────
# INITIAL ADMIN CREDENTIALS
# Used only once on first startup if no admins exist in the database.
# ──────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=manager@frenchbellcafe.com
ADMIN_PASSWORD=replace_with_strong_password_minimum_8_chars

# ──────────────────────────────────────────────────────────────────────────────
# DATABASE — PostgreSQL (required)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://frenchbell:your_db_password@localhost:5432/frenchbell_db

# ──────────────────────────────────────────────────────────────────────────────
# DEVELOPMENT / TEST OTP MODE
#
# TEST_OTP_MODE=true        — Enables fixed dev OTP. Real SMS is NOT sent.
#                             Only valid when NODE_ENV is 'development' or 'test'.
#                             Production startup will REJECT this if NODE_ENV=production.
# DEV_FIXED_OTP             — The fixed 4-digit OTP code shown to developers.
#
# HOW TO USE IN DEVELOPMENT:
#   1. Set TEST_OTP_MODE=true
#   2. Set DEV_FIXED_OTP=1234
#   3. Enter any mobile number on the login page
#   4. Enter 1234 when prompted for the OTP
#
# TO DISABLE FOR PRODUCTION:
#   Set TEST_OTP_MODE=false (or omit entirely) and configure a real SMS provider.
# ──────────────────────────────────────────────────────────────────────────────
TEST_OTP_MODE=true
DEV_FIXED_OTP=1234

# ──────────────────────────────────────────────────────────────────────────────
# PAYMENT — SIMULATED / DUMMY MODE (current)
#
# No real payment provider is active. All payments are simulated test transactions.
# Clearly marked TEST/SIMULATED in the UI and receipt.
# No real money is charged. No real card/banking data is collected.
#
# PAYMENT_PROVIDER=dummy    — Use simulated payment provider (default for development)
# ──────────────────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=dummy

# ──────────────────────────────────────────────────────────────────────────────
# RAZORPAY TEST MODE (optional — not activated yet)
# Uncomment and fill in when enabling Razorpay Test Mode.
# Keys must be TEST keys only (rzp_test_...). Never use live keys in development.
# Payment signature verification happens server-side. Never trust client-submitted results.
# ──────────────────────────────────────────────────────────────────────────────
# RAZORPAY_KEY_ID=rzp_test_your_key_id_here
# RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret_here

# ──────────────────────────────────────────────────────────────────────────────
# RECEIPT DELIVERY — configurable destination phone number
#
# Receipts are currently retained in the customer account and available for
# download/print. No SMS or WhatsApp provider is activated.
#
# RECEIPT_DISPATCH_PHONE_NUMBER — A single E.164 destination number for receipt
#   delivery when a messaging provider is configured.
#   Format: +91XXXXXXXXXX (10-digit Indian mobile with country code)
#   This number is NEVER exposed to customers. Only used server-side.
#   Leave blank or omit if no messaging provider is configured.
#
# When a WhatsApp/SMS provider is connected later:
#   - The system will send receipts to this number after successful payment
#   - Until then, "Receipt messaging is not configured" is shown in the account
# ──────────────────────────────────────────────────────────────────────────────
RECEIPT_DISPATCH_PHONE_NUMBER=+91XXXXXXXXXX

# ──────────────────────────────────────────────────────────────────────────────
# EMAIL — Admin Invitations & Password Resets
# Choose EMAIL_PROVIDER: 'smtp' | 'resend' | 'sendgrid' | 'brevo'
# If unconfigured, invitation links are shown in server logs (development only).
# ──────────────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
EMAIL_FROM="FrenchBell Cafe" <your_email@gmail.com>

# SMTP (Gmail App Password, Amazon SES, Brevo SMTP, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password

# Resend (alternative)
# RESEND_API_KEY=re_your_resend_api_key_here

# SendGrid (alternative)
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Brevo / Sendinblue (alternative)
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# ──────────────────────────────────────────────────────────────────────────────
# SMS / WHATSAPP PROVIDER (optional — not activated, documented for future use)
#
# DO NOT integrate MSG91, Fast2SMS, or Twilio as part of the current task.
# These are documented here for when a real SMS provider is connected later.
# ──────────────────────────────────────────────────────────────────────────────
# SMS_PROVIDER=fast2sms
# FAST2SMS_API_KEY=your_fast2sms_authorization_token_here

# TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# MSG91_AUTH_KEY=your_msg91_auth_key_here
# MSG91_TEMPLATE_ID=your_dlt_approved_template_id_here

# WhatsApp Business Cloud API
# WHATSAPP_API_KEY=your_whatsapp_api_key_here
# WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
