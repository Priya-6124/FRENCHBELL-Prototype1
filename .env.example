# FrenchBell Cafe Environment Configuration Example
PORT=5000
JWT_SECRET=your_jwt_secret_key_here
ADMIN_EMAIL=manager@frenchbellcafe.com
ADMIN_PASSWORD=your_secure_admin_password
OTP_PROVIDER_KEY=your_otp_provider_key
WHATSAPP_API_KEY=your_whatsapp_api_key
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Real Email Delivery Configuration (smtp, resend, sendgrid, or brevo)
EMAIL_PROVIDER=smtp
EMAIL_FROM="FrenchBell Cafe" <manager@frenchbellcafe.com>

# SMTP Server Details (Works with Gmail App Password, Brevo, SendGrid, Amazon SES, Outlook)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user_or_email@gmail.com
SMTP_PASSWORD=your_secure_app_password_here

# Optional Direct REST Email API Keys
RESEND_API_KEY=your_resend_api_key
SENDGRID_API_KEY=your_sendgrid_api_key
BREVO_API_KEY=your_brevo_api_key
