# ==============================================================================
# FrenchBell Cafe Environment Configuration Example
# Copy this file to '.env' and fill in the values for your deployment.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# Server & Application Setup
PORT=5000
APP_URL=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_cryptographic_secret_key_minimum_32_chars

# Initial Primary Admin Credentials (used if no admins exist in database yet)
ADMIN_EMAIL=manager@frenchbellcafe.com
ADMIN_PASSWORD=replace_with_strong_password_minimum_8_chars

# ==============================================================================
# Real Customer SMS OTP Provider Configuration
# Choose SMS_PROVIDER: 'fast2sms' | 'twilio' | 'msg91'
# If unconfigured, the system returns a clear configuration error to the user.
# ==============================================================================
SMS_PROVIDER=fast2sms

# Option A: Fast2SMS (Recommended for Indian numbers, Quick setup)
FAST2SMS_API_KEY=your_fast2sms_authorization_token_here

# Option B: Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Option C: MSG91
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_dlt_approved_template_id_here

# Optional: WhatsApp Business Cloud API / Gateway (for order notifications)
WHATSAPP_API_KEY=your_whatsapp_api_key_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# ==============================================================================
# Real Email Delivery Configuration (Admin Invitations, Password Resets)
# Choose EMAIL_PROVIDER: 'smtp' | 'resend' | 'sendgrid' | 'brevo'
# If unconfigured, the system returns an explicit configuration error.
# ==============================================================================
EMAIL_PROVIDER=smtp
EMAIL_FROM="FrenchBell Cafe" <your_email@gmail.com>

# Option 1: SMTP Server (Gmail App Password, Amazon SES, Brevo, SendGrid, Outlook)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password

# Option 2: Resend REST API
RESEND_API_KEY=re_your_resend_api_key_here

# Option 3: SendGrid REST API
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Option 4: Brevo (Sendinblue) REST API
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
